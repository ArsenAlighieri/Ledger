# LEDGER Environment Configuration

# ZeroTier private IP address of your host machine
# Docker will publish the port exclusively to this IP address
ZEROTIER_IP=10.147.17.1

# Application port (inside container & exposed on ZeroTier interface)
APP_PORT=8085

# Persistent database and backup directories
DB_PATH=/app/data/ledger.db
BACKUP_DIR=/app/data/backups

# Market data cache TTL in minutes
FX_TTL_MINUTES=60
STOCK_TTL_MINUTES=30

# Optional API Keys (if using custom commercial providers)
# MARKET_DATA_API_KEY=
